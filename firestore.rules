rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Luna's Esthetics — Firestore Security Rules ──────────────────────
    //
    // The database is CLOSED to the public.
    //
    // Until 2026-09-09 these rules were `allow read, write: if true`, which meant
    // anyone who knew the project id could download every customer record - names,
    // phone numbers, email addresses - or overwrite the lot. It was reported to us
    // by a member of the public who found it while browsing the site.
    //
    // The website no longer talks to Firestore at all. It calls this site's own
    // API (Cloudflare Pages Functions under /api), and only that server - signed
    // in as the dedicated service account below - may touch these documents.
    //
    // The service account is a Firebase Authentication user whose credentials
    // live in the Cloudflare environment, never in the browser.
    //
    // If you ever need to work in the Firebase console directly, do it as the
    // project owner - console access is not affected by these rules.
    // ──────────────────────────────────────────────────────────────────────

    function isServer() {
      return request.auth != null
          && request.auth.uid == 'REPLACE_WITH_SERVER_UID';
    }

    // Every site_data document: server only, both directions.
    match /site_data/{key} {
      allow read: if isServer();
      allow write: if isServer();
      allow delete: if false;
    }

    // Nothing else in the database is reachable by anyone.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
