rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Luna's Esthetics — Firestore Security Rules ──────────────────────
    //
    // CURRENT STATE: No Firebase Auth is implemented.
    // All 9 site_data keys require open read/write for the following reasons:
    //   READS:  _syncOnLoad (script.js) fetches all keys on every page load
    //   WRITES: admin panel + booking form write all keys without auth tokens
    //
    // The Firebase API key in script.js is intentionally public (Google design).
    // Real protection comes from Auth-gated Firestore rules — see Future State below.
    //
    // THESE RULES ARE TEMPORARY. Apply the Future State rules after Firebase Auth
    // migration is complete (Phase 2 of the security roadmap).
    // ──────────────────────────────────────────────────────────────────────

    // ── ANTI-WIPE BACKSTOP (added 2026-08-30 after a real data-loss incident) ──
    //
    // Each site_data doc holds an ENTIRE collection as one JSON string in `value`,
    // and every write is a read-modify-write of that whole string. On 2026-08-30
    // site_data/bookings went from ~60KB to ~400 bytes in a single PATCH, wiping
    // ~100 real bookings: a client's read timed out, the code treated the failure
    // as "no data", and one new booking was written over everything.
    //
    // Every legitimate write adds, edits, or removes ONE record, so these
    // documents never shrink materially. This refuses any write that does.
    //
    // NOTE ON RULE SEMANTICS: Firestore ORs all matching path rules, so this guard
    // MUST live inside the single wildcard match below. A separate
    // `match /site_data/bookings` block would be completely defeated by the
    // wildcard's own `allow write`.
    //
    // ESCAPE HATCH: a deliberate bulk delete or a restore from a SMALLER backup
    // will be denied. To do one, temporarily comment out the guard in the Firebase
    // Console (Firestore → Rules → Publish), perform the change, then restore it.
    // Not applied to blocked_dates/services/specials/courses/manual_events/
    // pro_order_counter — those legitimately shrink a lot and are easy to re-enter.
    function notCatastrophicShrink(pct) {
      return request.resource.data.value is string
          && (resource == null
              || !('value' in resource.data)
              || !(resource.data.value is string)
              || request.resource.data.value.size() * 100 >= resource.data.value.size() * pct);
    }

    match /site_data/{key} {
      allow read: if true;
      allow write: if !(key in ['bookings', 'clients', 'course_enrollments', 'pro_orders'])
                   || notCatastrophicShrink(60);
      allow delete: if false;
    }

    // ── Future State (requires Firebase Auth migration) ───────────────────
    //
    // Step 1: Enable Firebase Authentication (Email/Password) in Firebase Console.
    // Step 2: Add a custom claim `admin: true` to the admin user via Firebase Admin SDK.
    // Step 3: Replace the admin sessionStorage login with Firebase Auth sign-in.
    // Step 4: Update _fsSet/_fsGet to include the Firebase ID token in the Authorization header.
    // Step 5: Apply these rules:
    //
    // // Public catalog — readable by anyone, writable only by admin
    // match /site_data/{key} {
    //   allow read: if key in ['services', 'specials', 'courses', 'blocked_dates'];
    //   allow write: if request.auth != null && request.auth.token.admin == true;
    // }
    //
    // // Booking submission — public can write (booking form), admin can read + write
    // match /site_data/bookings {
    //   allow write: if true; // public booking form creates bookings
    //   allow read: if request.auth != null && request.auth.token.admin == true;
    // }
    //
    // // Sensitive data — admin only
    // match /site_data/{key} {
    //   allow read, write: if request.auth != null && request.auth.token.admin == true;
    //   // covers: clients, inventory, manual_events, course_enrollments
    // }
    //
    // ─────────────────────────────────────────────────────────────────────
  }
}
